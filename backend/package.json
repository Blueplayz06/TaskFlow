{
  "name": "taskflow-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "TaskFlow REST API — Node.js + Express + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev":        "nodemon src/server.js",
    "start":      "node src/server.js",
    "migrate":    "node -e \"import('./src/db/pool.js').then(m=>m.runMigrations()).then(()=>process.exit(0))\"",
    "test":       "node --experimental-vm-modules node_modules/.bin/jest --forceExit"
  },
  "dependencies": {
    "bcryptjs":   "^2.4.3",
    "cors":       "^2.8.5",
    "dotenv":     "^16.4.5",
    "express":    "^4.19.2",
    "helmet":     "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan":     "^1.10.0",
    "pg":         "^8.12.0"
  },
  "devDependencies": {
    "jest":       "^29.7.0",
    "nodemon":    "^3.1.4",
    "supertest":  "^7.0.0"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext":   "js,json",
    "ignore": ["src/db/migrations"]
  }
}
